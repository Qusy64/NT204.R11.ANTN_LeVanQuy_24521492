# ==============================================================================
# Test Case 04: Parse header TCP + any/single IP/CIDR + port/range (Muc 7.4)
# Mon hoc: He thong tim kiem, phat hien va ngan ngua xam nhap - NT204.R11.ANTN
# Sinh vien: Le Van Quy - MSSV: 24521492
# Ky vong: Chuyen doi day du cac dang header thanh Internal Rule Object chinh xac.
# ==============================================================================

# 1. Header: any IP + any Port
alert tcp any any -> any any (msg:"TC04 Any Header Pattern"; sid:300041; rev:1;)

# 2. Header: Single IPv4 + Single Port
alert tcp 192.168.1.100 any -> 10.0.0.1 80 (msg:"TC04 Single IP and Port"; sid:300042; rev:1;)

# 3. Header: CIDR Subnet + Port Range (min:max)
alert tcp 192.168.1.0/24 1024:2048 -> 10.0.0.0/8 80 (msg:"TC04 CIDR and Port Range"; sid:300043; rev:1;)

# 4. Header: Port Range Open Right (min:)
alert tcp any 1024: -> any 8080 (msg:"TC04 Open Right Port Range"; sid:300044; rev:1;)

# 5. Header: Port Range Open Left (:max) + CIDR Class B
alert udp any :1024 -> 172.16.0.0/16 53 (msg:"TC04 Open Left Port Range and CIDR"; sid:300045; rev:1;)

# 6. Header: Bidirectional direction (<>) + Port Range
alert tcp 192.168.1.50 8000:9000 <> 10.0.0.5 80 (msg:"TC04 Bidirectional Port Range"; sid:300046; rev:1;)
