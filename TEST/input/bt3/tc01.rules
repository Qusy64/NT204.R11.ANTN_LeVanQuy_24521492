# Dong comment o dau file

alert tcp 192.168.1.0/24 any -> 10.0.0.1 80 (msg:"TC01 Web Access Rule"; content:"GET /index.html"; nocase; sid:300001; rev:1;)

   # Comment co khoang trang o dau dong
   
# Dong trong tiep theo va comment phia tren rule thu 2
alert udp any any -> 8.8.8.8 53 (msg:"TC01 DNS Query Rule"; content:"google.com"; nocase; sid:300002; rev:1;)

