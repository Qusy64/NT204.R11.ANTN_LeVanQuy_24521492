# TC14 - Verify fields in the Detection Event generated by a matching rule.
# Input: tc14.pcap contains one HTTP request for /TC14-MARKER.
# Expected: SID 300141, rev 2, priority 2, classtype misc-activity.
# Packet endpoint, timestamp, HTTP protocol and flow context must be preserved.
# matched_info should identify TC14-MARKER at byte 5 of the TCP payload.

alert tcp 192.168.1.100 any -> 10.0.0.1 80 (msg:"TC14 Detection event fields"; content:"TC14-MARKER"; sid:300141; rev:2; classtype:misc-activity; priority:2;)
